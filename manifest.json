{
  "manifest_version": 3,
  "name": "Font Override JP",
  "version": "1.0.0",
  "description": "日本語フォントを Noto Sans JP で上書きする拡張機能",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
